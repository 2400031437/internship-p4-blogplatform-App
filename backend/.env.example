# ---- Backend settings ----
PORT=5000
# Local MongoDB (default). For MongoDB Atlas paste your connection string here instead, e.g.
# MONGO_URL=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/blogapp
MONGO_URL=mongodb://127.0.0.1:27017/blogapp
# Any long random text
JWT_SECRET=change_this_to_a_long_random_secret_text
# Frontend address(es) allowed to call the API (comma separated)
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
